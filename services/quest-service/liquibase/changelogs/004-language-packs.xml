<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="014" author="dev">
        <comment>Create language_packs table</comment>
        <createTable tableName="language_packs">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="language_code" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="language_name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="is_current" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            
            <!-- Real-world terminology -->
            <column name="real_quest_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="real_quest_reward_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="real_epic_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="real_adventure_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="real_character_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="real_guild_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="real_skill_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="real_design_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="real_proof_of_concept_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="real_implement_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="real_bug_check_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="real_subdivide_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            
            <!-- In-game terminology -->
            <column name="game_quest_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="game_quest_reward_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="game_epic_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="game_adventure_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="game_character_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="game_guild_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="game_skill_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="game_design_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="game_proof_of_concept_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="game_implement_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="game_bug_check_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="game_subdivide_term" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <createIndex indexName="idx_language_packs_language_code" tableName="language_packs">
            <column name="language_code"/>
        </createIndex>
        
        <createIndex indexName="idx_language_packs_is_current" tableName="language_packs">
            <column name="is_current"/>
        </createIndex>
    </changeSet>
    
    <changeSet id="015" author="dev">
        <comment>Insert default English language pack</comment>
        <insert tableName="language_packs">
            <column name="id" valueComputed="uuid_generate_v4()"/>
            <column name="language_code" value="en"/>
            <column name="language_name" value="English"/>
            <column name="is_current" valueBoolean="true"/>
            <column name="created_at" valueComputed="now()"/>
            <column name="updated_at" valueComputed="now()"/>
            
            <!-- Real-world terminology -->
            <column name="real_quest_term" value="Task"/>
            <column name="real_quest_reward_term" value="Reward"/>
            <column name="real_epic_term" value="Project"/>
            <column name="real_adventure_term" value="Portfolio"/>
            <column name="real_character_term" value="User"/>
            <column name="real_guild_term" value="Team"/>
            <column name="real_skill_term" value="Skill"/>
            <column name="real_design_term" value="Design"/>
            <column name="real_proof_of_concept_term" value="Proof of Concept"/>
            <column name="real_implement_term" value="Implementation"/>
            <column name="real_bug_check_term" value="Bug Fix"/>
            <column name="real_subdivide_term" value="Subdivide"/>
            
            <!-- In-game terminology -->
            <column name="game_quest_term" value="Quest"/>
            <column name="game_quest_reward_term" value="Bounty"/>
            <column name="game_epic_term" value="Saga"/>
            <column name="game_adventure_term" value="Adventure"/>
            <column name="game_character_term" value="Adventurer"/>
            <column name="game_guild_term" value="Guild"/>
            <column name="game_skill_term" value="Magic"/>
            <column name="game_design_term" value="Plan"/>
            <column name="game_proof_of_concept_term" value="Experiment"/>
            <column name="game_implement_term" value="Craft"/>
            <column name="game_bug_check_term" value="Ward"/>
            <column name="game_subdivide_term" value="Split"/>
        </insert>
    </changeSet>
    
    <changeSet id="016" author="dev">
        <comment>Update quests table to add quest_type and skills_required</comment>
        <addColumn tableName="quests">
            <column name="skills_required" type="varchar[]">
                <constraints nullable="true"/>
            </column>
            <column name="quest_type" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
            <column name="creator_character_id" type="uuid">
                <constraints nullable="true"/>
            </column>
            <column name="requestor_character_id" type="uuid">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        
        <createIndex indexName="idx_quests_quest_type" tableName="quests">
            <column name="quest_type"/>
        </createIndex>
        
        <createIndex indexName="idx_quests_creator_character_id" tableName="quests">
            <column name="creator_character_id"/>
        </createIndex>
        
        <createIndex indexName="idx_quests_requestor_character_id" tableName="quests">
            <column name="requestor_character_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog> 